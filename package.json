{
  "name": "vector-resume-builder",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "description": "Fully client-side resume builder that exports a true-vector PDF (selectable text, embedded fonts) with no backend.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "gen:fonts": "node scripts/gen-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:pdf": "node scripts/verify-pdfs.mjs",
    "gen:favicons": "node scripts/gen-favicons.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "astro": "^7.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^1.21.0",
    "posthog-js": "^1.399.1",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "pdfjs-dist": "^4.7.76",
    "puppeteer-core": "^23.11.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  }
}
