---
// src/pages/404.astro
// Custom 404 page. In this static build Astro emits it as 404.html and the
// dev/preview server serves it for unknown routes. Datasheet/blueprint
// aesthetic matching /about, /privacy, /alternatives and /vs pages.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import "../styles/marketing.css";

const title = "Page not found (404) — papersfly";
const description =
  "The page you're looking for doesn't exist. papersfly is a free, 100% client-side document builder — head back and start creating.";
---

<BaseLayout title={title} description={description} noindex noSchema>
  <div class="site">
    <div class="wrap">
      <SiteHeader />
      <div class="cmp-hero">
        <div class="cmp-head">
          <span class="cmp-eyebrow">Error · 404</span>
          <h1 class="cmp-title">This page isn't on the <span class="accent">blueprint.</span></h1>
          <p class="cmp-lede">
            The page you're looking for doesn't exist — it may have been moved
            or the link was mistyped. Everything still runs in your browser;
            let's get you back to it.
          </p>
          <div class="cta-row" style="margin-top:24px">
            <a class="btn btn-primary" href="/">
              Back home
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn btn-ghost" href="/create-resume">Build a resume</a>
          </div>
        </div>
        <div class="cmp-tblock">
          <div class="r"><div class="c"><span class="k">Drawing</span><span class="v big">err-404</span></div><div class="c"><span class="k">Rev</span><span class="v">1.0</span></div></div>
          <div class="r"><div class="c"><span class="k">Sheet</span><span class="v">ERR-404</span></div><div class="c"><span class="k">Scope</span><span class="v">papersfly</span></div></div>
          <div class="r"><div class="c"><span class="k">Type</span><span class="v">Web app</span></div><div class="c"><span class="k">Status</span><span class="v">Not found</span></div></div>
        </div>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
