---
// src/pages/build/[doc]/[template].astro
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { App } from "../../../App";
import { documents } from "../../../documents/registry";
import { buildBuilderPaths, createHref } from "../../../lib/routing";
import Logo from "../../../components/site/Logo.astro";

export function getStaticPaths() {
  return buildBuilderPaths(documents).map(({ doc, template }) => ({
    params: { doc, template },
  }));
}

const { doc, template } = Astro.params;

const docType = documents.find((d) => d.id === doc);
const tmpl = docType?.templates.find((t) => t.id === template);
const docName = docType?.name ?? "Document";
const docLower = docName.toLowerCase();
const templateName = tmpl?.name ?? "Document";
const templateDesc = tmpl?.description;

// Unique per template so each of the /build/* pages is distinct to crawlers
// (previously all résumé pages shared one title + description).
const title = `${templateName} ${docLower} template — free vector PDF | papersfly`;
const description = `Build a ${docLower} with the ${templateName} template${
  templateDesc ? ` — ${templateDesc}` : ""
}. Export a true-vector PDF with selectable text and embedded fonts. No signup, works offline.`;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    {
      "@type": "ListItem",
      position: 2,
      name: `${docName} builder`,
      item: new URL(createHref(doc), Astro.site).href,
    },
    { "@type": "ListItem", position: 3, name: `${templateName} template`, item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} extraJsonLd={[breadcrumb]}>
  {/* The builder is browser-only (jsPDF + live layout measurement); this static
      skeleton gives an instant paint and is removed when the React app mounts.
      It also carries the page's real, crawlable <h1> for non-JS/AI crawlers. */}
  <div id="app-skeleton" class="app-skeleton">
    <Logo size={32} />
    <h1>{templateName} {docLower} builder</h1>
    <p>Live preview · true-vector PDF · 100% offline</p>
    <p class="app-skeleton__hint">Loading the editor…</p>
  </div>

  <App client:only="react" docId={doc} templateId={template} />
</BaseLayout>

<script is:inline>
  // Remove the static skeleton as soon as the React app (.app) mounts.
  const skeleton = document.getElementById("app-skeleton");
  if (skeleton) {
    const obs = new MutationObserver(() => {
      if (document.querySelector(".app")) {
        skeleton.remove();
        obs.disconnect();
      }
    });
    obs.observe(document.body, { childList: true, subtree: true });
  }
</script>
