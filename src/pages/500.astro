---
// src/pages/500.astro
// Custom 500 page, built to 500.html. papersfly is fully client-side with no
// server runtime, so a 500 is only ever produced by the host/CDN — this static
// file exists for a host to serve on origin errors (host config is out of
// scope). Datasheet/blueprint aesthetic matching /about, /privacy and /vs pages.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import "../styles/marketing.css";

const title = "Something went wrong (500) — papersfly";
const description =
  "An unexpected error occurred. papersfly runs entirely in your browser, so your document data stays safe on your device. Reload or head back to start again.";
---

<BaseLayout title={title} description={description} noindex noSchema>
  <div class="site">
    <div class="wrap">
      <SiteHeader />
      <div class="cmp-hero">
        <div class="cmp-head">
          <span class="cmp-eyebrow">Error · 500</span>
          <h1 class="cmp-title">Something <span class="accent">came off the rails.</span></h1>
          <p class="cmp-lede">
            An unexpected error occurred. papersfly runs entirely in your
            browser, so your document data is safe on your device. Try
            reloading, or head back and start again.
          </p>
          <div class="cta-row" style="margin-top:24px">
            <a class="btn btn-primary" href="/">
              Back home
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a class="btn btn-ghost" href="/create-resume">Build a resume</a>
          </div>
        </div>
        <div class="cmp-tblock">
          <div class="r"><div class="c"><span class="k">Drawing</span><span class="v big">err-500</span></div><div class="c"><span class="k">Rev</span><span class="v">1.0</span></div></div>
          <div class="r"><div class="c"><span class="k">Sheet</span><span class="v">ERR-500</span></div><div class="c"><span class="k">Scope</span><span class="v">papersfly</span></div></div>
          <div class="r"><div class="c"><span class="k">Type</span><span class="v">Web app</span></div><div class="c"><span class="k">Status</span><span class="v">Server error</span></div></div>
        </div>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
