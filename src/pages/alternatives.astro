---
// src/pages/alternatives.astro
// Hub page: "conformance report" — a master datasheet comparing papersfly to
// every competitor, plus links to each /vs/<competitor> page.
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import { competitors, PRICING_AS_OF, PRICING_YEAR, PRICING_ISO, METHODOLOGY, ALTERNATIVES_FAQ, faqPageJsonLd } from "../data/competitors";
import "../styles/marketing.css";

const year = PRICING_YEAR;
const title = `Best free resume builder alternatives (${year}) — papersfly`;
const description =
  "Compare papersfly with Resume.io, Zety, Canva, Novoresume and more. See which resume builders are truly free, need no signup, and keep your data on your device.";

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name: "Comparisons", item: canonical },
  ],
};

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "papersfly vs resume builder comparisons",
  numberOfItems: competitors.length,
  itemListElement: competitors.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: `papersfly vs ${c.name}`,
    url: new URL(`/vs/${c.slug}`, Astro.site).href,
  })),
};

const faqPage = faqPageJsonLd(ALTERNATIVES_FAQ);

const webPage = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
  dateModified: PRICING_ISO,
};
---

<BaseLayout
  title={title}
  description={description}
  extraJsonLd={[breadcrumb, itemList, faqPage, webPage]}
  ogImagePath="/og/alternatives.png"
>
  <div class="site">
    <div class="wrap">
      <SiteHeader />
      <div class="cmp-hero">
        <div class="cmp-head">
          <span class="cmp-eyebrow">Comparison · Conformance report</span>
          <h1 class="cmp-title">Which builders <span class="accent">meet spec?</span></h1>
          <p class="cmp-lede">
            A resume builder should give you the file, keep your data, and cost nothing. We measured
            every major builder against that spec. One of them is ours — here's the honest reading.
          </p>
          <span class="cmp-updated">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            Verified {PRICING_AS_OF}
          </span>
        </div>
        <div class="cmp-tblock">
          <div class="r"><div class="c"><span class="k">Drawing</span><span class="v big">papersfly</span></div><div class="c"><span class="k">Rev</span><span class="v">2.0</span></div></div>
          <div class="r"><div class="c"><span class="k">Sheet</span><span class="v">CMP-00</span></div><div class="c"><span class="k">Units</span><span class="v">pt</span></div><div class="c"><span class="k">Scale</span><span class="v">1:1</span></div></div>
          <div class="r"><div class="c"><span class="k">Verified</span><span class="v">{PRICING_AS_OF}</span></div><div class="c"><span class="k">Status</span><span class="v ok">Approved</span></div></div>
        </div>
      </div>
    </div>

    <section class="section">
      <div class="wrap">
        <div class="cmp-sheet">
          <div class="cmp-sheet-h">
            <span class="t">Conformance matrix</span>
            <span class="meta">4 criteria · {competitors.length + 1} builders · verified {PRICING_AS_OF}</span>
          </div>
          <div class="cmp-sheet-scroll">
            <table class="cmp-table cmp-matrix">
              <thead>
                <tr>
                  <th scope="col">Builder</th>
                  <th scope="col" class="cmp-us">Cost for a usable PDF</th>
                  <th scope="col">Free PDF download</th>
                  <th scope="col">No signup</th>
                  <th scope="col">Data on device</th>
                </tr>
              </thead>
              <tbody>
                <tr class="cmp-row-us">
                  <td class="cmp-name cmp-us">papersfly</td>
                  <td class="cmp-mono pass" data-label="Cost for a usable PDF">Free</td>
                  <td data-label="Free PDF download"><span class="cmp-mark pass"><span class="b">✓</span></span></td>
                  <td data-label="No signup"><span class="cmp-mark pass"><span class="b">✓</span></span></td>
                  <td data-label="Data on device"><span class="cmp-mark pass"><span class="b">✓</span></span></td>
                </tr>
                {competitors.map((c) => {
                  const freeYes = c.quick.freeDownload === "Yes";
                  const freeNote = c.quick.freeDownload === "No" ? "" : c.quick.freeDownload;
                  return (
                    <tr>
                      <td class="cmp-name"><a href={`/vs/${c.slug}`}>{c.name}</a></td>
                      <td class="cmp-mono" data-label="Cost for a usable PDF">{c.quick.price}</td>
                      <td data-label="Free PDF download">
                        <span class={`cmp-mark ${freeYes ? "pass" : "fail"}`}>
                          <span class="b">{freeYes ? "✓" : "✗"}</span>
                          {!freeYes && freeNote && <span class="cmp-note">{freeNote}</span>}
                        </span>
                      </td>
                      <td data-label="No signup"><span class={`cmp-mark ${c.quick.noSignup === "Yes" ? "pass" : "fail"}`}><span class="b">{c.quick.noSignup === "Yes" ? "✓" : "✗"}</span></span></td>
                      <td data-label="Data on device"><span class={`cmp-mark ${c.quick.onDevice === "Yes" ? "pass" : "fail"}`}><span class="b">{c.quick.onDevice === "Yes" ? "✓" : "✗"}</span></span></td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
        <p class="cmp-caption">Pricing verified {PRICING_AS_OF}. Sources on each comparison page.</p>
        <div class="cta-row" style="margin-top:24px">
          <a class="btn btn-primary" href="/create-resume">
            Build a resume free
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap">
        <div class="cmp-rule-h"><h2 class="lbl">Detail · head-to-head</h2><span class="ln"></span></div>
        <div class="cmp-cards">
          {competitors.map((c) => (
            <a class="cmp-card" href={`/vs/${c.slug}`}>
              <span class="cmp-card-tag">{c.tagline}</span>
              <span class="cmp-card-name">vs {c.name}</span>
              <span class="cmp-card-text">{c.cardBlurb}</span>
              <span class="cmp-card-cta">Read comparison →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="cmp-rule-h"><h2 class="lbl">FAQ</h2><span class="ln"></span></div>
        <div class="cmp-faq">
          {ALTERNATIVES_FAQ.map((f) => (
            <div class="cmp-faq-item">
              <h3 class="cmp-faq-q">{f.q}</h3>
              <p class="cmp-faq-a">{f.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap">
        <div class="cmp-rule-h"><h2 class="lbl">How we compare</h2><span class="ln"></span></div>
        <div class="cmp-prose">
          <p>{METHODOLOGY}</p>
          <p class="cmp-caption">Reviewed by the papersfly team · verified {PRICING_AS_OF}</p>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</BaseLayout>
