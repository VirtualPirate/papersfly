---
// src/pages/create-resume.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import { CreateGallery } from "../components/create/CreateGallery";
import "../styles/marketing.css";

const title = "Free résumé builder — papersfly";
const description =
  "Build a résumé in your browser and export a true-vector PDF with selectable text and embedded fonts. No signup, no upload — works offline.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Vector Résumé Builder",
  description,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (modern web browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "Live résumé preview",
    "True-vector PDF export with selectable text and embedded fonts",
    "Works fully offline in the browser",
  ],
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="site">
    <div class="wrap">
      <SiteHeader />
      <div class="create-head">
        <h1 class="create-title">Create a résumé</h1>
        <p class="create-sub">
          Pick a résumé template, fill it in, and export a true-vector PDF —
          selectable text, embedded fonts. Everything renders in your browser —
          nothing is uploaded.
        </p>
      </div>
      <CreateGallery client:only="react" activeDocId="resume" />
    </div>
  </div>
</BaseLayout>
