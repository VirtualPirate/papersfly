---
// src/components/site/Logo.astro
// The papersfly logo lockup — a "page + paper-plane" mark launching out of the
// sheet, next to the papersfly wordmark (Saira Condensed, "fly" in the accent).
// Ported verbatim from brand/brand-mark.html so the site and the brand sheet
// never drift. Self-contained: colours read the site tokens (--ink / --accent /
// --rule-strong / --f-display) when inside `.site`, and fall back to the
// blueprint literals (light + .dark) so the logo is correct anywhere it is used.
interface Props {
  /** Wordmark font-size in px; the mark scales with it. */
  size?: number;
  /** Render as a link when set; otherwise a plain inline element. */
  href?: string;
  /** Extra class(es) forwarded to the root. */
  class?: string;
  /** Accessible name (the logo reads as one word to assistive tech). */
  label?: string;
}
const { size = 22, href, class: className, label = "papersfly" } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  class:list={["pf-logo", className]}
  style={`--pf-size:${size}px`}
  aria-label={label}
  {...href ? { href } : {}}
>
  <svg class="pf-mark" viewBox="0 0 52 52" aria-hidden="true">
    <rect x="5.5" y="9.5" width="34" height="38" fill="none" class="pf-frame" stroke-width="1.6" />
    <path d="M9 13 h6 M9 13 v6" class="pf-frame" stroke-width="1.6" fill="none" />
    <path d="M36 44 h-6 M36 44 v-6" class="pf-frame" stroke-width="1.6" fill="none" />
    <g class="pf-doc" stroke-width="1.5" stroke-linecap="round">
      <path d="M11 39 h22" /><path d="M11 43 h14" />
    </g>
    <g>
      <path d="M49 3 L18 17 L31 20.5 Z" class="pf-far" />
      <path d="M49 3 L31 20.5 L28 32 Z" class="pf-near" />
    </g>
  </svg>
  <span class="pf-word" aria-hidden="true">papers<span class="pf-fly">fly</span></span>
</Tag>

<style>
  .pf-logo {
    /* resolve to site tokens inside `.site`; blueprint-light literals elsewhere */
    --_ink: var(--ink, #12233c);
    --_accent: var(--accent, #23588f);
    --_rule: var(--rule-strong, #12233c);
    --_display: var(--f-display, "Saira Condensed", "Arial Narrow", system-ui, sans-serif);

    display: inline-flex;
    align-items: center;
    gap: calc(var(--pf-size) * 0.42);
    color: var(--_ink);
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
  }
  /* dark fallback for use outside `.site` (inside `.site` the token already flips) */
  :global(html.dark) .pf-logo {
    --_ink: var(--ink, #eaf3ff);
    --_accent: var(--accent, #7ad4ea);
    --_rule: var(--rule-strong, #eaf3ff);
  }

  .pf-mark {
    display: block;
    width: calc(var(--pf-size) * 1.34);
    height: calc(var(--pf-size) * 1.34);
    flex: none;
  }
  .pf-frame { stroke: var(--_rule); opacity: 0.34; }
  .pf-doc { stroke: var(--_rule); opacity: 0.26; }
  .pf-far { fill: var(--_ink); }
  .pf-near { fill: var(--_accent); }

  .pf-word {
    font-family: var(--_display);
    font-weight: 700;
    font-size: var(--pf-size);
    line-height: 0.86;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--_ink);
  }
  .pf-fly { color: var(--_accent); }

  a.pf-logo:focus-visible {
    outline: 2px solid var(--_accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
